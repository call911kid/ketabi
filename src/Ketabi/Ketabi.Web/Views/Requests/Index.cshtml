@model Ketabi.Web.ViewModels.Requests.RequestsIndexViewModel

@{
    ViewData["Title"] = "My Requests";
}

<style>
    .requests-page {
        background: radial-gradient(circle at top left, rgba(91, 91, 214, 0.14), transparent 22%),
                    radial-gradient(circle at bottom right, rgba(91, 91, 214, 0.08), transparent 20%),
                    #f8f9ff;
    }

    .requests-hero {
        background: linear-gradient(135deg, rgba(91, 91, 214, 0.14), rgba(255, 255, 255, 0.95));
        border: 1px solid rgba(91, 91, 214, 0.18);
        box-shadow: 0 24px 60px rgba(27, 36, 80, 0.08);
        border-radius: 32px;
        padding: 2rem 2rem 2.5rem;
        margin-bottom: 2.5rem;
        position: relative;
        overflow: hidden;
        animation: fadeInUp 0.8s ease both;
    }

    .requests-hero::before {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(91, 91, 214, 0.34), transparent 58%);
        top: -40px;
        right: -50px;
        filter: blur(12px);
    }

    .requests-hero::after {
        content: "";
        position: absolute;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(91, 91, 214, 0.20), transparent 62%);
        bottom: -20px;
        left: -20px;
        filter: blur(8px);
    }

    .request-tablist .nav-link {
        border-radius: 999px;
        padding: 0.85rem 1.4rem;
        border: 1px solid transparent;
        transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
        color: var(--bs-body-color);
        font-weight: 600;
    }

    .request-tablist .nav-link.active {
        background: linear-gradient(135deg, #5b5bd6, #2c2ca8);
        color: #ffffff;
        box-shadow: 0 18px 40px rgba(91, 91, 214, 0.22);
    }

    .request-tablist .nav-link:hover {
        transform: translateY(-1px);
        border-color: rgba(91, 91, 214, 0.18);
    }

    .request-card {
        border: 1px solid rgba(91, 91, 214, 0.1);
        border-radius: 28px;
        overflow: hidden;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        background: #ffffff;
    }

    .request-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 60px rgba(34, 44, 90, 0.08);
    }

    .request-card-header {
        background: rgba(91, 91, 214, 0.04);
        border-bottom: 1px solid rgba(91, 91, 214, 0.08);
        padding: 1.15rem 1.25rem;
    }

    .request-card-body {
        padding: 1.4rem 1.25rem 1.5rem;
    }

    .request-card-footer {
        gap: 0.75rem;
    }

    .request-status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 96px;
        height: 34px;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 0 0.95rem;
    }

    .status-pending { background: rgba(253, 186, 116, 0.18); color: #7a5800; }
    .status-approved { background: rgba(34, 197, 94, 0.16); color: #166534; }
    .status-rejected { background: rgba(248, 113, 113, 0.18); color: #9b1c1c; }
    .status-completed { background: rgba(56, 189, 248, 0.18); color: #0369a1; }
    .status-cancelled { background: rgba(107, 114, 128, 0.16); color: #374151; }

    .request-label {
        font-size: 0.78rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: #6c757d;
    }

    .empty-state-card {
        border: 1px dashed rgba(91, 91, 214, 0.2);
        background: rgba(91, 91, 214, 0.04);
        border-radius: 24px;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="requests-page container-fluid px-3 px-lg-5 py-5">
    <div class="container">
        <section class="requests-hero">
            <span class="badge bg-primary text-white mb-3" style="width: fit-content;">Request Center</span>
            <h1 class="fw-bold mb-3">Manage your requests with confidence</h1>
            <p class="text-muted mb-0">Track incoming and outgoing book requests, respond faster, and keep every exchange visual and clear.</p>
        </section>

        <section class="card border-0 shadow-sm rounded-4 p-3 mb-4 request-tabs-panel">
            <ul class="nav nav-pills request-tablist flex-wrap" id="requestsTab" role="tablist">
                <li class="nav-item me-0 me-sm-2 mb-2 mb-sm-0" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "incoming" ? "active" : "")"
                            id="incoming-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#incoming"
                            type="button"
                            role="tab"
                            aria-controls="incoming"
                            aria-selected="@(Model.ActiveTab == "incoming")">
                        Received Requests
                        @if (Model.IncomingCount > 0)
                        {
                            <span class="badge bg-white text-primary ms-2 px-2 py-1 shadow-sm">@Model.IncomingCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "outgoing" ? "active" : "")"
                            id="outgoing-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#outgoing"
                            type="button"
                            role="tab"
                            aria-controls="outgoing"
                            aria-selected="@(Model.ActiveTab == "outgoing")">
                        Sent Requests
                        @if (Model.OutgoingCount > 0)
                        {
                            <span class="badge bg-white text-primary ms-2 px-2 py-1 shadow-sm">@Model.OutgoingCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "pending" ? "active" : "")"
                            id="pending-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#pending"
                            type="button"
                            role="tab"
                            aria-controls="pending"
                            aria-selected="@(Model.ActiveTab == "pending")">
                        My Pending Books
                        @if (Model.PendingCount > 0)
                        {
                            <span class="badge bg-white text-primary ms-2 px-2 py-1 shadow-sm">@Model.PendingCount</span>
                        }
                    </button>
                </li>
            </ul>
        </section>

        <div class="tab-content mt-3" id="requestsTabContent">
            <div class="tab-pane fade @(Model.ActiveTab == "incoming" ? "show active" : "")"
                 id="incoming"
                 role="tabpanel"
                 aria-labelledby="incoming-tab">
                @if (Model.IsIncomingEmpty)
                {
                    <div class="text-center py-5 empty-state-card">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #5b5bd6;"></i>
                        <h5 class="mt-3">No incoming requests yet</h5>
                        <p class="text-muted">Requests from other users will appear here as soon as someone reaches out about your book listings.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4 requests-grid">
                        @foreach (var request in Model.IncomingRequests)
                        {
                            <div class="col-md-6 col-xl-4">
                                <partial name="~/Views/Shared/_RequestCard.cshtml" model="request" />
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="tab-pane fade @(Model.ActiveTab == "outgoing" ? "show active" : "")"
                 id="outgoing"
                 role="tabpanel"
                 aria-labelledby="outgoing-tab">
                @if (Model.IsOutgoingEmpty)
                {
                    <div class="text-center py-5 empty-state-card">
                        <i class="bi bi-send" style="font-size: 3rem; color: #5b5bd6;"></i>
                        <h5 class="mt-3">No outgoing requests yet</h5>
                        <p class="text-muted">Sent requests will appear here so you can follow their status in one place.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4 requests-grid">
                        @foreach (var request in Model.OutgoingRequests)
                        {
                            <div class="col-md-6 col-xl-4">
                                <partial name="~/Views/Shared/_RequestCard.cshtml" model="request" />
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="tab-pane fade @(Model.ActiveTab == "pending" ? "show active" : "")"
                 id="pending"
                 role="tabpanel"
                 aria-labelledby="pending-tab">
                @if (Model.IsPendingEmpty)
                {
                    <div class="text-center py-5 empty-state-card">
                        <i class="bi bi-clock-history" style="font-size: 3rem; color: #5b5bd6;"></i>
                        <h5 class="mt-3">No pending books</h5>
                        <p class="text-muted">Books you've uploaded are waiting for admin approval and will appear here until they're reviewed.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4 requests-grid">
                        @foreach (var book in Model.PendingBooks)
                        {
                            <div class="col-md-6 col-xl-4">
                                <partial name="~/Views/Shared/_PendingBookCard.cshtml" model="book" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('#requestsTab .nav-link').forEach(tab => {
            tab.addEventListener('shown.bs.tab', function (e) {
                const target = e.target.getAttribute('data-bs-target').substring(1);
                const url = new URL(window.location);
                url.searchParams.set('tab', target);
                window.history.pushState({}, '', url);
            });
        });
    </script>
}