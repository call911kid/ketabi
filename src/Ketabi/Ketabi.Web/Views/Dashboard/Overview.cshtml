@model Ketabi.Application.DTOs.Dashboard.PlatformOverviewDto

@{
    ViewData["Title"] = "Platform Overview";
    Layout = "_AdminLayout";
}

<div style="display: flex; flex-direction: column; gap: 24px;">
    <div>
        <h2 style="font-size: 22px; font-weight: 800; color: #0F172A;">Platform Overview</h2>
        <p style="font-size: 14px; color: #64748B; margin-top: 2px;">Real-time snapshot of Ketabi's health and activity.</p>
    </div>

    <!-- KPI Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
        <div style="background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); border: 1px solid #E2E8F0; display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: #6366F118; display: flex; align-items: center; justify-content: center; color: #6366F1;">
                    <i class="bi bi-people-fill" style="font-size: 20px;"></i>
                </div>
                <div style="display: flex; align-items: center; gap: 4px; font-size: 12px; color: #10B981; font-weight: 600;">
                    <i class="bi bi-arrow-up" style="font-size: 13px;"></i>
                    +@Model.NumberOfUserThisMonth% this month
                </div>
            </div>
            <div>
                <p style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1;">@Model.NumberOfUsers</p>
                <p style="font-size: 13px; color: #64748B; margin-top: 4px;">Total Users</p>
            </div>
        </div>

        <div style="background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); border: 1px solid #E2E8F0; display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: #F59E0B18; display: flex; align-items: center; justify-content: center; color: #F59E0B;">
                    <i class="bi bi-book" style="font-size: 20px;"></i>
                </div>
                <div style="display: flex; align-items: center; gap: 4px; font-size: 12px; color: #94A3B8; font-weight: 600;">
                    Needs review
                </div>
            </div>
            <div>
                <p style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1;">@Model.NumberOfPendingListings</p>
                <p style="font-size: 13px; color: #64748B; margin-top: 4px;">Pending Approvals</p>
            </div>
        </div>

        <div style="background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); border: 1px solid #E2E8F0; display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: #10B98118; display: flex; align-items: center; justify-content: center; color: #10B981;">
                    <i class="bi bi-arrow-left-right" style="font-size: 20px;"></i>
                </div>
                <div style="display: flex; align-items: center; gap: 4px; font-size: 12px; color: #10B981; font-weight: 600;">
                    <i class="bi bi-arrow-up" style="font-size: 13px;"></i>
                    +@Model.NumberOfTradesThisWeek% this week
                </div>
            </div>
            <div>
                <p style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1;">@Model.NumberOfActiveTrades</p>
                <p style="font-size: 13px; color: #64748B; margin-top: 4px;">Active Trades</p>
            </div>
        </div>

        <div style="background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); border: 1px solid #E2E8F0; display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: #3B82F618; display: flex; align-items: center; justify-content: center; color: #3B82F6;">
                    <i class="bi bi-shield-check" style="font-size: 20px;"></i>
                </div>
                <div style="display: flex; align-items: center; gap: 4px; font-size: 12px; color: #10B981; font-weight: 600;">
                    Excellent
                </div>
            </div>
            <div>
                <p style="font-size: 26px; font-weight: 800; color: #0F172A; line-height: 1;">@Model.PlatformHealth%</p>
                <p style="font-size: 13px; color: #64748B; margin-top: 4px;">Platform Health</p>
            </div>
        </div>
    </div>

    <!-- Alert Banner -->
    @if (Model.HighPriorityReportsCount > 0)
    {
        <div style="background: #FEF2F2; border: 1px solid #FECACA; border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; gap: 10;">
            <i class="bi bi-exclamation-triangle-fill" style="color: #EF4444; font-size: 16px;"></i>
            <p style="font-size: 13px; color: #EF4444; font-weight: 600;">@Model.HighPriorityReportsCount high-priority report@(Model.HighPriorityReportsCount > 1 ? "s" : "") require@(Model.HighPriorityReportsCount == 1 ? "s" : "") immediate attention.</p>
        </div>
    }

    <!-- Charts Row -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <!-- Area Chart -->
        <div style="background: #fff; border-radius: 14px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); border: 1px solid #E2E8F0; min-height: 300px;">
            <h3 style="font-size: 15px; font-weight: 700; color: #0F172A; margin-bottom: 4px;">Growth Trends</h3>
            <p style="font-size: 12px; color: #94A3B8; margin-bottom: 16px;">Users & books added over the past 7 months</p>
            <div style="position: relative; height: 250px;">
                <canvas id="growthChart"></canvas>
            </div>
        </div>

        <!-- Pie Chart -->
        <div style="background: #fff; border-radius: 14px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); border: 1px solid #E2E8F0; min-height: 300px;">
            <h3 style="font-size: 15px; font-weight: 700; color: #0F172A; margin-bottom: 4px;">Book Categories</h3>
            <p style="font-size: 12px; color: #94A3B8; margin-bottom: 8px;">Distribution across @Model.CategoryDistribution.Count() categories</p>
            <div style="position: relative; height: 220px;">
                <canvas id="categoryChart"></canvas>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 12px;">
                @foreach (var cat in Model.CategoryDistribution.Take(4))
                {
                    <div style="display: flex; align-items: center; gap: 5px;">
                        <div style="width: 8px; height: 8px; border-radius: 2px; background: @cat.Color;"></div>
                        <span style="font-size: 11px; color: #64748B;">@cat.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div style="background: #fff; border-radius: 14px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); border: 1px solid #E2E8F0;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
            <i class="bi bi-clock" style="color: #10B981; font-size: 16px;"></i>
            <h3 style="font-size: 15px; font-weight: 700; color: #0F172A;">Recent Admin Activity</h3>
        </div>
        <div>
            @foreach (var log in Model.RecentAuditLogs.Take(5))
            {
                <div style="display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid #F1F5F9;">
                    <div style="width: 8px; height: 8px; border-radius: 50%; background: @(log.Severity == "critical" ? "#EF4444" : log.Severity == "warning" ? "#F59E0B" : "#3B82F6"); margin-top: 5px; flex-shrink: 0;"></div>
                    <div style="flex: 1; min-width: 0;">
                        <p style="font-size: 13px; font-weight: 600; color: #0F172A; margin: 0;">@log.Action — <span style="font-weight: 400; color: #475569;">@log.Target</span></p>
                        <p style="font-size: 12px; color: #64748B; margin: 2px 0 0 0;">by @log.AdminName</p>
                    </div>
                    <p style="font-size: 11px; color: #94A3B8; flex-shrink: 0; white-space: nowrap;">@log.Timestamp.ToString("MMM d")</p>
                </div>
            }
        </div>
        <p style="font-size: 12px; color: #94A3B8; margin-top: 12px; text-align: center;">Showing 5 of @Model.RecentAuditLogs.Count() recent actions</p>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Growth Chart
        const growthCtx = document.getElementById('growthChart');
        const growthLabels = @Html.Raw(Json.Serialize(Model.UserGrowth.Select(g => g.Month).ToList()));
        const growthUsers = @Html.Raw(Json.Serialize(Model.UserGrowth.Select(g => g.NumberOfUsers).ToList()));
        const growthBooks = @Html.Raw(Json.Serialize(Model.UserGrowth.Select(g => g.NumberOfBooks).ToList()));

        new Chart(growthCtx, {
            type: 'line',
            data: {
                labels: growthLabels,
                datasets: [
                    {
                        label: 'Users',
                        data: growthUsers,
                        borderColor: '#6366F1',
                        backgroundColor: 'rgba(99, 102, 241, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2
                    },
                    {
                        label: 'Books',
                        data: growthBooks,
                        borderColor: '#10B981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#F1F5F9' },
                        ticks: { color: '#94A3B8', font: { size: 11 } }
                    },
                    x: {
                        grid: { color: '#F1F5F9' },
                        ticks: { color: '#94A3B8', font: { size: 11 } }
                    }
                },
                plugins: {
                    legend: { 
                        display: true,
                        position: 'top',
                        labels: { color: '#64748B', font: { size: 11 }, usePointStyle: true }
                    }
                }
            }
        });

        // Category Pie Chart
        const categoryCtx = document.getElementById('categoryChart');
        const categoryLabels = @Html.Raw(Json.Serialize(Model.CategoryDistribution.Select(c => c.Name).ToList()));
        const categoryValues = @Html.Raw(Json.Serialize(Model.CategoryDistribution.Select(c => c.Value).ToList()));
        const categoryColors = @Html.Raw(Json.Serialize(Model.CategoryDistribution.Select(c => c.Color).ToList()));

        new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: categoryLabels,
                datasets: [
                    {
                        data: categoryValues,
                        backgroundColor: categoryColors,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '55%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ' + context.parsed;
                            }
                        }
                    }
                }
            }
        });
    </script>
}