@{
    ViewData["Title"] = "Under Development";
}

<section class="container py-5" style="min-height: calc(100vh - 190px);">
    <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 220px);">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card rounded-4 shadow-sm border-0 overflow-hidden">
                <div class="card-body p-5 text-center">
                    <div class="mx-auto mb-4 d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 96px; height: 96px; background: rgba(91, 91, 214, 0.12);">
                        <i class="bi bi-tools fs-1 text-primary"></i>
                    </div>

                    <h1 class="display-6 fw-bold mb-3">The resource is under development</h1>
                    <p class="text-muted fs-5 mb-4">Enjoy the rest of the website until it becomes ready for you.</p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">
                            Return to Explore
                        </a>
                        <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary btn-lg px-4">
                            Privacy Policy
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
