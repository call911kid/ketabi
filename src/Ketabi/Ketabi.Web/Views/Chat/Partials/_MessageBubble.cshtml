@model Ketabi.Web.ViewModels.Chat.MessageViewModel

@if (Model.ShowDateDivider)
{
  <div class="chat-divider">
    <span class="chat-divider__label">@Model.DateLabel</span>
  </div>
}

<div class="chat-bubble-row @(Model.IsMine ? "chat-bubble-row--mine" : "chat-bubble-row--theirs")" data-sender-id="@Model.SenderId" data-msg-id="@Model.MessageId">
  @if (!Model.IsMine)
  {
    <img src="@(string.IsNullOrEmpty(Model.SenderAvatarUrl) ? "/uploads/users/default-avatar.png" : $"/uploads/users/{Model.SenderAvatarUrl}")"
         alt="@Model.SenderName"
         class="chat-bubble-row__avatar" loading="lazy" />
  }
  <div class="chat-bubble-group">
    <div class="chat-bubble @(Model.IsMine ? "chat-bubble--mine" : "chat-bubble--theirs")">
      @Html.Raw(System.Net.WebUtility.HtmlEncode(Model.Text))
    </div>
    @* BUG 7: Only render timestamp at the last bubble of a consecutive sender run *@
    @if (Model.ShowTimestamp)
    {
      <span class="chat-bubble-group__time">
        @Model.FormattedTime
        @* Read receipt — only on own messages; JS upgrades sent→read icon *@
        @if (Model.IsMine)
        {
          <span class="read-receipt read-receipt--sent" aria-label="Sent">
            <i class="bi bi-check2" aria-hidden="true"></i>
          </span>
        }
      </span>
    }
  </div>
</div>
