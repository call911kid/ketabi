@model Ketabi.Web.ViewModels.Chat.ConversationDetailViewModel

<div class="chat-window">

  @await Html.PartialAsync("Partials/_ChatHeader",   Model)
  @await Html.PartialAsync("Partials/_JourneyBar",   Model)
  @await Html.PartialAsync("Partials/_StatusBanner", Model)

  <!-- Messages feed: flex-1 scrollable -->
  <div class="chat-window__feed" id="chat-feed">
    @foreach (var msg in Model.Messages)
    {
      @await Html.PartialAsync("Partials/_MessageBubble", msg)
    }

    <!-- Scroll anchor — JS calls scrollIntoView() on this element -->
    <div id="chat-feed-end"></div>
  </div>

  @if (Model.ShowHandoffBar)
  {
    @await Html.PartialAsync("Partials/_HandoffConfirm", Model)
  }

  @if (Model.ShowMessageInput)
  {
    <!-- Message input bar — fixed to the bottom of the chat window -->
    <div class="chat-input-bar">
      <textarea id="chat-input"
                class="chat-input-bar__textarea form-control"
                placeholder="Type a message…"
                rows="1"
                aria-label="Message input"></textarea>
      <button id="chat-send-btn"
              class="chat-input-bar__send-btn"
              aria-label="Send message"
              disabled>
        <i class="bi bi-send-fill" aria-hidden="true"></i>
      </button>
    </div>
  }

  @if (Model.ShowReviewForm)
  {
    <div id="review-modal"
         class="review-modal review-modal--open"
         role="dialog"
         aria-modal="true"
         aria-labelledby="review-modal-title">
      <div class="review-modal__backdrop"></div>
      <div class="review-modal__dialog">
        <button id="review-modal-close"
                class="review-modal__close"
                aria-label="Close review">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        @await Html.PartialAsync("Partials/_ReviewForm", Model)
      </div>
    </div>
  }

</div>
