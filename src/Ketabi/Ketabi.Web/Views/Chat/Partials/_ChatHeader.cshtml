@model Ketabi.Web.ViewModels.Chat.ConversationDetailViewModel

<header class="chat-header">

  <!-- Mobile back button (hidden on md+) -->
  <a href="/Chat" class="chat-header__back-btn d-md-none" aria-label="Back to inbox">
    <i class="bi bi-arrow-left" aria-hidden="true"></i>
  </a>

  <!-- Book cover thumbnail -->
  @{
      var cover = Model.Book?.CoverImageUrl ?? string.Empty;
      string coverSrc;
      if (string.IsNullOrEmpty(cover))
      {
          coverSrc = "/img/cover-placeholder.svg";
      }
      else if (cover.StartsWith("/") || cover.StartsWith("http", StringComparison.OrdinalIgnoreCase))
      {
          coverSrc = cover;
      }
      else
      {
          coverSrc = $"/uploads/books/{cover}";
      }
  }

  <img src="@coverSrc"
       alt="@Model.Book.Title"
       class="chat-header__book-cover" loading="lazy" />

  <!-- Book info -->
  <div class="chat-header__book-info">
    <p class="chat-header__book-title">@Model.Book.Title</p>
    <div class="chat-header__meta">
      @if (Model.RequestType == Ketabi.Web.ViewModels.Chat.RequestType.Exchange)
      {
        <span class="chat-header__meta-item">
          <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Exchange
        </span>
      }
      else
      {
        <span class="chat-header__meta-item">
          <i class="bi bi-book" aria-hidden="true"></i>
          Borrow · @Model.BorrowDurationDays d
        </span>
      }
      <span class="chat-header__meta-sep d-none d-lg-inline">·</span>
      <span class="chat-header__meta-item d-none d-lg-inline-flex">with @Model.OtherUser.FullName</span>
    </div>
  </div>

  <!-- Spacer -->
  <div class="chat-header__spacer"></div>

  <!-- Other user info (right side) -->
  <div class="chat-header__user" data-presence-user="@Model.OtherUser.UserId">
    <img src="@(string.IsNullOrEmpty(Model.OtherUser.AvatarUrl) ? "/uploads/users/default-avatar.png" : $"/uploads/users/{Model.OtherUser.AvatarUrl}")"
         alt="@Model.OtherUser.FullName"
         class="chat-header__user-avatar" loading="lazy" />
    <div class="chat-header__user-info d-none d-md-block">
      <p class="chat-header__user-name">@Model.OtherUser.FullName</p>
      <div class="chat-header__user-meta">
        @* Presence indicator (dot + label) — updated by JS via UserPresenceChanged *@
        <span class="presence-status" id="presence-status">

          <span class="presence-dot presence-dot--offline" id="presence-dot" aria-hidden="true"></span>
          <span class="presence-label" id="presence-label">Offline</span>
        </span>
        <span class="chat-header__user-sep">·</span>
        <i class="bi bi-geo-alt" aria-hidden="true"></i>
        <span>@Model.OtherUser.Location</span>
        @if (!string.IsNullOrEmpty(Model.OtherUser.FormattedRating))
        {
          <span class="chat-header__user-sep">·</span>
          <i class="bi bi-star-fill chat-header__star-icon" aria-hidden="true"></i>
          <span class="chat-header__user-rating">@Model.OtherUser.FormattedRating</span>
        }
      </div>
    </div>
  </div>

</header>
