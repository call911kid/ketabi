@model Ketabi.Web.ViewModels.Chat.ConversationDetailViewModel

<div class="handoff-bar" id="handoff-bar">

  <!-- Collapsible toggle header -->
  <button type="button"
          class="handoff-bar__toggle"
          id="handoff-toggle"
          aria-expanded="true"
          aria-controls="handoff-content">
    <span class="handoff-bar__toggle-label">
      <i class="bi bi-shield-check" aria-hidden="true" style="color: var(--color-indigo); margin-right: 6px;"></i>
      Confirm Physical Handoff
    </span>
    <div class="handoff-bar__toggle-right">
      <span class="handoff-bar__mini-status">
        @if (Model.CurrentUserConfirmedHandoff)
        {
          <span style="color: var(--color-success); font-size: 0.8rem;"><i class="bi bi-check-circle-fill"></i> You confirmed</span>
        }
        else
        {
          <span style="color: var(--color-text-muted); font-size: 0.8rem;">Action Required</span>
        }
      </span>
      <i class="bi bi-chevron-down handoff-bar__chevron" aria-hidden="true"></i>
    </div>
  </button>

  <!-- Collapsible body -->
  <div class="handoff-bar__body" id="handoff-content">
    <div class="handoff-bar__grid">
      
      <!-- Left side: Avatars & Status -->
      <div class="handoff-bar__left">
        <div class="handoff-bar__avatars-group">
          <!-- Current User -->
          <div class="handoff-bar__avatar-item">
            <div class="handoff-bar__img-container">
              <img src="@(string.IsNullOrEmpty(Model.CurrentUserAvatarUrl) ? "/uploads/users/default-avatar.png" : $"/uploads/users/{Model.CurrentUserAvatarUrl}")"
                   alt="You"
                   class="handoff-bar__avatar-img"
                   style="width:36px;height:36px;border-radius:50%;object-fit:cover;display:block;flex-shrink:0;" />
              @if (Model.CurrentUserConfirmedHandoff)
              {
                <span class="handoff-bar__badge-success"><i class="bi bi-check"></i></span>
              }
            </div>
            <span class="handoff-bar__name-label @(Model.CurrentUserConfirmedHandoff ? "confirmed" : "")">You</span>
          </div>

          <!-- Connection arrows -->
          <div class="handoff-bar__connection-arrow">
            <i class="bi bi-arrow-left-right"></i>
          </div>

          <!-- Other User -->
          <div class="handoff-bar__avatar-item">
            <div class="handoff-bar__img-container">
              <img src="@(string.IsNullOrEmpty(Model.OtherUser.AvatarUrl) ? "/uploads/users/default-avatar.png" : $"/uploads/users/{Model.OtherUser.AvatarUrl}")"
                   alt="@Model.OtherUser.FullName"
                   class="handoff-bar__avatar-img"
                   style="width:36px;height:36px;border-radius:50%;object-fit:cover;display:block;flex-shrink:0;" />
              @if (Model.OtherUserConfirmedHandoff)
              {
                <span class="handoff-bar__badge-success"><i class="bi bi-check"></i></span>
              }
            </div>
            <span class="handoff-bar__name-label @(Model.OtherUserConfirmedHandoff ? "confirmed" : "")">@Model.OtherUser.FullName.Split(' ')[0]</span>
          </div>
        </div>
      </div>

      <!-- Right side: Confirm Action -->
      <div class="handoff-bar__right">
        <form asp-controller="Chat" asp-action="ConfirmHandoff" method="post" style="width: 100%;">
          <input type="hidden" name="conversationId" value="@Model.ConversationId" />
          @Html.AntiForgeryToken()
          <button type="submit" class="handoff-bar__btn-confirm">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            I Confirm the Handoff
          </button>
        </form>
      </div>

    </div>
    
    <p class="handoff-bar__hint-text">
      Tap only after the book has physically changed hands. Once both parties confirm, you can leave a review.
    </p>

  </div>
</div>
