@model Ketabi.Web.ViewModels.Books.BookDetailViewModel

<div class="book-details-panel">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <span class="badge" style="background-color: var(--color-indigo-light); color: var(--color-indigo); padding: 6px 16px; border-radius: var(--radius-full); font-size: var(--text-sm-pill); font-weight: var(--weight-medium);">
            @Model.Category
        </span>
        @if (!string.IsNullOrWhiteSpace(Model.Language))
        {
            <span class="badge" style="background-color: var(--color-surface); color: var(--color-text-muted); border: 1px solid var(--color-border); padding: 6px 16px; border-radius: var(--radius-full); font-size: var(--text-sm-pill);">
                @Model.Language
            </span>
        }
        <span class="badge @Model.SharingModeBadgeCss" style="padding: 6px 16px; border-radius: var(--radius-full); font-size: var(--text-sm-pill); font-weight: var(--weight-medium);">
            @Model.SharingMode
        </span>
        <span class="badge" style="background-color: @(Model.IsAvailable ? "var(--color-success-bg)" : "var(--color-danger-bg)"); color: @(Model.IsAvailable ? "var(--color-success)" : "var(--color-danger)"); padding: 6px 16px; border-radius: var(--radius-full); font-size: var(--text-sm-pill); font-weight: var(--weight-medium);">
            @(Model.IsAvailable ? "Available" : "Not available")
        </span>
    </div>

    <h1 class="mb-2" style="font-size: 2.5rem; font-weight: var(--weight-extrabold); letter-spacing: var(--tracking-tight); color: var(--color-text);">
        @Model.Title
    </h1>
    <p class="mb-4" style="font-size: var(--text-base); color: var(--color-text-muted); font-weight: var(--weight-medium);">
        by <span style="color: var(--color-text);">@Model.Author</span>
    </p>

    <div class="detail-grid mb-4" style="display:grid; gap:1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
        @if (!string.IsNullOrWhiteSpace(Model.ISBN))
        {
            <div>
                <p class="text-uppercase mb-1" style="font-size: var(--text-xs-label); color: var(--color-text-muted); letter-spacing: .08em;">ISBN</p>
                <p style="font-weight: var(--weight-semibold); color: var(--color-text);">@Model.ISBN</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Publisher))
        {
            <div>
                <p class="text-uppercase mb-1" style="font-size: var(--text-xs-label); color: var(--color-text-muted); letter-spacing: .08em;">Publisher</p>
                <p style="font-weight: var(--weight-semibold); color: var(--color-text);">@Model.Publisher</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.LocationNote))
        {
            <div>
                <p class="text-uppercase mb-1" style="font-size: var(--text-xs-label); color: var(--color-text-muted); letter-spacing: .08em;">Location</p>
                <p style="font-weight: var(--weight-semibold); color: var(--color-text);">@Model.LocationNote</p>
            </div>
        }
    </div>

    <div class="description-section">
        <h5 class="mb-3" style="font-size: var(--text-base); font-weight: var(--weight-bold); color: var(--color-text);">Description</h5>
        <p style="font-size: var(--text-base); line-height: var(--leading-body); color: var(--color-text-muted);">
            @Model.Description
        </p>
    </div>
</div>