@model Ketabi.Web.ViewModels.Books.BookDetailViewModel

<div class="modal fade" id="borrowModal" tabindex="-1" aria-labelledby="borrowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="borrowModalLabel">Borrow this book</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="CreateBorrowRequest" asp-controller="Books" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input asp-for="BorrowRequest.BookId" type="hidden" />

                    @if (!Model.CanBorrow)
                    {
                        <div class="alert alert-warning mb-0">This listing is not available for borrowing.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="BorrowRequest.ReturnDate" class="form-label">Return Date</label>
                            <input asp-for="BorrowRequest.ReturnDate" class="form-control" type="date" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="BorrowRequest.ReturnDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BorrowRequest.Note" class="form-label">Message to owner (optional)</label>
                            <textarea asp-for="BorrowRequest.Note" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="BorrowRequest.Note" class="text-danger"></span>
                        </div>

                        <div class="alert alert-light border p-3">
                            <div><strong>Book:</strong> @Model.Title</div>
                            <div><strong>Owner:</strong> @Model.Owner.FullName</div>
                            <div><strong>Suggested duration:</strong> @Model.BorrowDurationOptions.FirstOrDefault()?.Text ?? "3 Days"</div>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    @if (Model.CanBorrow)
                    {
                        <button type="submit" class="btn btn-primary">Request borrow</button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
