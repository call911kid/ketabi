@model Ketabi.Web.ViewModels.Books.CreateBookViewModel

<div class="mb-5">
    <h5 class="fw-bold mb-3" style="font-size: var(--text-md);">Book Condition</h5>
    @* Hidden input handles model binding; radios use plain name= to avoid data-val conflict *@
    <input type="hidden" name="Condition" id="Condition_Hidden" value="" />
    <div class="row g-3">
        <!-- New -->
        <div class="col-md-6">
            <input type="radio" name="_Condition_UI" value="New" class="btn-check condition-check" id="cond_New" autocomplete="off">
            <label class="btn w-100 text-start p-3 rounded-3 condition-card bg-white" for="cond_New" style="border: 1px solid var(--color-surface-muted);">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold condition-title" style="color: var(--color-success); font-size: var(--text-sm);">New</span>
                    <i class="bi bi-check-circle check-icon d-none" style="color: var(--color-success);"></i>
                </div>
                <div class="text-muted" style="font-size: var(--text-xs);">Unread, like bought from a store</div>
            </label>
        </div>
        
        <!-- Good -->
        <div class="col-md-6">
            <input type="radio" name="_Condition_UI" value="Good" class="btn-check condition-check" id="cond_Good" autocomplete="off">
            <label class="btn w-100 text-start p-3 rounded-3 condition-card bg-white" for="cond_Good" style="border: 1px solid var(--color-surface-muted);">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold condition-title" style="color: var(--color-info); font-size: var(--text-sm);">Good</span>
                    <i class="bi bi-check-circle check-icon d-none" style="color: var(--color-info);"></i>
                </div>
                <div class="text-muted" style="font-size: var(--text-xs);">Read once or twice, no damage</div>
            </label>
        </div>
        
        <!-- Fair -->
        <div class="col-md-6">
            <input type="radio" name="_Condition_UI" value="Fair" class="btn-check condition-check" id="cond_Fair" autocomplete="off">
            <label class="btn w-100 text-start p-3 rounded-3 condition-card bg-white" for="cond_Fair" style="border: 1px solid var(--color-surface-muted);">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold condition-title" style="color: var(--color-warning); font-size: var(--text-sm);">Fair</span>
                    <i class="bi bi-check-circle check-icon d-none" style="color: var(--color-warning);"></i>
                </div>
                <div class="text-muted" style="font-size: var(--text-xs);">Some highlighting or wear</div>
            </label>
        </div>
        
        <!-- Worn -->
        <div class="col-md-6">
            <input type="radio" name="_Condition_UI" value="Worn" class="btn-check condition-check" id="cond_Worn" autocomplete="off">
            <label class="btn w-100 text-start p-3 rounded-3 condition-card bg-white" for="cond_Worn" style="border: 1px solid var(--color-surface-muted);">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold condition-title" style="color: var(--color-error); font-size: var(--text-sm);">Worn</span>
                    <i class="bi bi-check-circle check-icon d-none" style="color: var(--color-error);"></i>
                </div>
                <div class="text-muted" style="font-size: var(--text-xs);">Heavily used but still readable</div>
            </label>
        </div>
    </div>
</div>

<div class="mb-4">
    <h5 class="fw-bold mb-3" style="font-size: var(--text-md);">How do you want to share it?</h5>
    @* Hidden input handles model binding; radios use plain name= to avoid data-val conflict *@
    <input type="hidden" name="SharingMode" id="SharingMode_Hidden" value="" />
    <div class="d-flex flex-column gap-3">
        
        <!-- Borrow Only -->
        <div class="sharing-option">
            <!-- Assuming value 'Borrow' maps to SharingMode enum. Adjust if your enum names differ (e.g. BorrowOnly, Free, etc) -->
            <input type="radio" name="_SharingMode_UI" value="Borrow" class="btn-check sharing-check" id="share_Borrow" autocomplete="off">
            <label class="btn w-100 text-start p-3 rounded-3 d-flex align-items-center sharing-card bg-white" for="share_Borrow" style="border: 1px solid var(--color-surface-muted);">
                <div class="icon-box rounded-3 bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-book text-muted"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold" style="font-size: var(--text-sm); color: var(--color-text);">Borrow Only</div>
                    <div class="text-muted" style="font-size: var(--text-xs);">Lend your book and get it back.</div>
                </div>
                <i class="bi bi-check-circle-fill check-icon d-none" style="color: var(--color-success); font-size: 20px;"></i>
            </label>
        </div>

        <!-- Exchange Only -->
        <div class="sharing-option">
            <input type="radio" name="_SharingMode_UI" value="Exchange" class="btn-check sharing-check" id="share_Exchange" autocomplete="off">
            <label class="btn w-100 text-start p-3 rounded-3 d-flex align-items-center sharing-card bg-white" for="share_Exchange" style="border: 1px solid var(--color-surface-muted);">
                <div class="icon-box rounded-3 bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-arrow-left-right text-muted"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold" style="font-size: var(--text-sm); color: var(--color-text);">Exchange Only</div>
                    <div class="text-muted" style="font-size: var(--text-xs);">Trade your book for another.</div>
                </div>
                <i class="bi bi-check-circle-fill check-icon d-none" style="color: var(--color-success); font-size: 20px;"></i>
            </label>
        </div>

        <!-- Both -->
        <div class="sharing-option">
            <input type="radio" name="_SharingMode_UI" value="Both" class="btn-check sharing-check" id="share_Both" autocomplete="off">
            <label class="btn w-100 text-start p-3 rounded-3 d-flex align-items-center sharing-card bg-white" for="share_Both" style="border: 1px solid var(--color-surface-muted);">
                <div class="icon-box rounded-3 bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-arrow-repeat text-muted"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold" style="font-size: var(--text-sm); color: var(--color-text);">Both Options</div>
                    <div class="text-muted" style="font-size: var(--text-xs);">Open to borrowing or exchanging.</div>
                </div>
                <i class="bi bi-check-circle-fill check-icon d-none" style="color: var(--color-success); font-size: 20px;"></i>
            </label>
        </div>
        
    </div>
</div>

<style>
    /* Styling for Condition Cards */
    
    #cond_New:checked + .condition-card { border-color: var(--color-success) !important; background-color: var(--color-success-bg) !important; }
    #cond_New:checked + .condition-card .check-icon { display: inline-block !important; }

    #cond_Good:checked + .condition-card { border-color: var(--color-info) !important; background-color: var(--color-info-bg) !important; }
    #cond_Good:checked + .condition-card .check-icon { display: inline-block !important; }

    #cond_Fair:checked + .condition-card { border-color: var(--color-warning) !important; background-color: var(--color-warning-bg) !important; }
    #cond_Fair:checked + .condition-card .check-icon { display: inline-block !important; }

    #cond_Worn:checked + .condition-card { border-color: var(--color-error) !important; background-color: var(--color-error-bg) !important; }
    #cond_Worn:checked + .condition-card .check-icon { display: inline-block !important; }

    /* Styling for Sharing Cards */
    .sharing-check:checked + .sharing-card {
        border-color: var(--color-success) !important;
        background-color: var(--color-success-bg) !important;
    }
    .sharing-check:checked + .sharing-card .check-icon {
        display: inline-block !important;
    }
    .sharing-check:checked + .sharing-card .icon-box {
        background-color: var(--color-success) !important;
        color: white !important;
    }
    .sharing-check:checked + .sharing-card .icon-box i {
        color: white !important;
    }
</style>

<script>
    // Sync Condition and SharingMode UI radios with hidden inputs used for model binding
    document.addEventListener('DOMContentLoaded', function () {
        const hiddenCond = document.getElementById('Condition_Hidden');
        const condRadios = document.querySelectorAll('input[name="_Condition_UI"]');

        function syncCondition(e) {
            const val = this.value || (e && e.target && e.target.value) || '';
            if (hiddenCond) hiddenCond.value = val;
            hiddenCond && hiddenCond.dispatchEvent(new Event('change', { bubbles: true }));
        }

        condRadios.forEach(r => {
            r.addEventListener('change', syncCondition);
            if (r.checked && hiddenCond && !hiddenCond.value) {
                hiddenCond.value = r.value;
            }
        });

        if (hiddenCond && hiddenCond.value) hiddenCond.dispatchEvent(new Event('change', { bubbles: true }));

        const hiddenShare = document.getElementById('SharingMode_Hidden');
        const shareRadios = document.querySelectorAll('input[name="_SharingMode_UI"]');

        function syncSharing(e) {
            const val = this.value || (e && e.target && e.target.value) || '';
            if (hiddenShare) hiddenShare.value = val;
            hiddenShare && hiddenShare.dispatchEvent(new Event('change', { bubbles: true }));
        }

        shareRadios.forEach(r => {
            r.addEventListener('change', syncSharing);
            if (r.checked && hiddenShare && !hiddenShare.value) {
                hiddenShare.value = r.value;
            }
        });

        if (hiddenShare && hiddenShare.value) hiddenShare.dispatchEvent(new Event('change', { bubbles: true }));
    });
</script>
