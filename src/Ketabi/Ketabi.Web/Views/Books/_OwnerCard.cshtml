@model Ketabi.Web.ViewModels.Books.BookDetailViewModel

<div class="card border-0 p-4"
     style="background-color: var(--color-surface); border-radius: var(--radius-2xl); box-shadow: var(--shadow-card);">
    <div class="d-flex align-items-center gap-3 mb-4" style="overflow: hidden;">
        <a asp-controller="Profile" asp-action="Index" asp-route-id="@Model.Owner.UserId"
               class="text-decoration-none d-flex align-items-center gap-3 w-100"
               style="min-width: 0;">
            <img src="~/uploads/users/@(string.IsNullOrEmpty(Model?.Owner?.AvatarUrl) ? "profile-picture.png" : Model.Owner.AvatarUrl)"
                 style="width: var(--avatar-md); height: var(--avatar-md); border-radius: 50%; object-fit: cover; flex-shrink: 0;">
                <div style="min-width: 0; flex: 1;">
                    <h6 class="mb-0" style="
                        font-weight: var(--weight-bold);
                        color: var(--color-text);
                        white-space: nowrap;    
                        overflow: hidden;      
                        text-overflow: ellipsis;
                        display: block;
                        ">
                        @Model.Owner.FullName
                </h6>
                <div class="d-flex align-items-center gap-1"
                     style="font-size: var(--text-xs-loc); color: var(--color-text-muted);">
                    <i class="bi bi-geo-alt" style="font-size: var(--icon-xs);"></i>
                    @Model.Owner.Location
                </div>
            </div>
        </a>
    </div>

    <div class="d-flex justify-content-between mb-4 p-3"
         style="background-color: var(--color-bg); border-radius: var(--radius-xl);">
        <div class="text-center">
            <span class="d-block"
                  style="font-weight: var(--weight-bold); color: var(--color-text);">@Model.Owner.ReputationScore ⭐</span>
            <small style="font-size: var(--text-xs); color: var(--color-text-muted);">Rating</small>
        </div>
    
    </div>

    @if (Model.IsOwner)
    {
        <a asp-action="Edit" asp-route-id="@Model.BookId" class="btn w-100 py-3"
               style="background-color: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); font-weight: var(--weight-semibold);">
            Edit Listing
        </a>

        <button type="button" class="btn btn-outline-danger w-100 py-3 mt-3"
                data-bs-toggle="modal"
                data-bs-target="#deleteListingModal-@Model.BookId"
                style="border-radius: var(--radius-lg); font-weight: var(--weight-semibold);">
            Delete Listing
        </button>

        <div class="modal fade" id="deleteListingModal-@Model.BookId" tabindex="-1" aria-labelledby="deleteListingModalLabel-@Model.BookId" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="border-radius: var(--radius-2xl); overflow: hidden; box-shadow: var(--shadow-card);">
                    <div class="modal-header" style="border-bottom: 1px solid var(--color-border);">
                        <h5 class="modal-title" id="deleteListingModalLabel-@Model.BookId" style="font-weight: var(--weight-bold); color: var(--color-text);">Confirm deletion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" style="background-color: var(--color-surface); color: var(--color-text);">
                        <p style="margin-bottom: 1rem; line-height: 1.6;">Are you sure you want to delete this listing? This action cannot be undone.</p>
                        <p class="text-muted" style="font-size: var(--text-sm);">Please confirm to permanently remove the book from your listings.</p>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--color-border); background-color: var(--color-surface);">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                                style="min-width: 8rem; font-weight: var(--weight-semibold);">Cancel</button>
                        <form asp-action="Delete" asp-route-id="@Model.BookId" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger" style="min-width: 8rem; font-weight: var(--weight-semibold);">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-grid gap-3">
            @if (Model.CanExchange)
            {
                <button class="btn py-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#exchangeModal"
                        style="background-color: var(--color-indigo); color: white; border-radius: var(--radius-lg); font-weight: var(--weight-bold); box-shadow: var(--shadow-btn-primary);">
                    Propose Exchange
                </button>
            }

            @if (Model.CanBorrow)
            {
                <button class="btn py-3" data-bs-toggle="modal" data-bs-target="#borrowModal"
                        style="background-color: transparent; border: 1px solid var(--color-indigo); color: var(--color-indigo); border-radius: var(--radius-lg); font-weight: var(--weight-bold);">
                    Borrow Book
                </button>
            }
        </div>
    }
    else
    {
        <div class="d-grid gap-3">
            <a asp-controller="Account" asp-action="Login" class="btn py-3"
                   style="background-color: var(--color-indigo); color: white; border-radius: var(--radius-lg); font-weight: var(--weight-bold); text-align: center;">Log
                in to request</a>
            </div>
        }
    </div>