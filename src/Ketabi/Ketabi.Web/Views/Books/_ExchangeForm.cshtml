@model Ketabi.Web.ViewModels.Books.BookDetailViewModel

<div class="modal fade" id="exchangeModal" tabindex="-1" aria-labelledby="exchangeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exchangeModalLabel">Propose an exchange</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!Model.CanExchange)
                {
                    <div class="alert alert-warning mb-0">This listing is not available for exchange.</div>
                }
                else
                {
                    <p>Exchange requests are not yet available in this version.</p>
                    @if (Model.ViewerAvailableBooks.Any())
                    {
                        <p>Select one of your own books to offer in exchange, then submit the request.</p>
                        <div class="list-group">
                            @foreach (var book in Model.ViewerAvailableBooks)
                            {
                                <div class="list-group-item">
                                    <strong>@book.Title</strong> by @book.Author
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">You do not have any available books to offer for exchange yet.</div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                @if (Model.CanExchange && Model.ViewerAvailableBooks.Any())
                {
                    <button type="button" class="btn btn-warning" disabled>Propose exchange (coming soon)</button>
                }
            </div>
        </div>
    </div>
</div>
