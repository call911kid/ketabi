@model Ketabi.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In — Ketabi";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-form-inner">

    <!-- Heading -->
    <h1 style="font-size:1.75rem;font-weight:var(--weight-extrabold);color:var(--color-text);letter-spacing:var(--tracking-tight);margin-bottom:4px;font-family:var(--font-primary);">
        Welcome back
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="auth-title-icon inline-block text-indigo-600 mb-1" style="vertical-align: middle;">
            <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/>
            <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"/>
            <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"/>
            <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
        </svg>
    </h1>
    <p style="font-size:0.875rem;color:var(--color-text-muted);margin-bottom:1.75rem;">Sign in to continue exploring books in your community.</p>

    <!-- Mode Toggle -->
    <div style="display:flex;background:var(--color-surface-muted);border-radius:var(--radius-lg);padding:4px;margin-bottom:1.5rem;">
        <a asp-controller="Account" asp-action="Login" class="auth-mode-btn-active"
           style="flex:1;text-align:center;padding:10px;border-radius:var(--radius-md);font-size:0.875rem;font-weight:var(--weight-semibold);font-family:var(--font-primary);text-decoration:none;transition:all var(--duration-base) var(--ease-default);">Sign In</a>
        <a asp-controller="Account" asp-action="Register" class="auth-mode-btn-inactive"
           style="flex:1;text-align:center;padding:10px;border-radius:var(--radius-md);font-size:0.875rem;font-weight:var(--weight-semibold);font-family:var(--font-primary);text-decoration:none;transition:all var(--duration-base) var(--ease-default);">Sign Up</a>
    </div>

    <!-- Google OAuth -->
    <button type="button" id="googleLoginBtn" class="auth-google-btn"
            onclick="window.location.href='@Url.Action("GoogleLogin","Account")'"
            style="width:100%;display:flex;align-items:center;justify-content:center;gap:10px;padding:13px 20px;border-radius:var(--radius-lg);border:1.5px solid rgba(0,0,0,0.12);background:var(--color-surface);font-size:0.875rem;font-weight:var(--weight-semibold);color:var(--color-text);font-family:var(--font-primary);cursor:pointer;margin-bottom:1.25rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continue with Google
    </button>

    <!-- Divider -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:1.25rem;">
        <div style="flex:1;height:1px;background:var(--border);"></div>
        <span style="font-size:0.75rem;color:var(--color-text-muted);white-space:nowrap;">or continue with email</span>
        <div style="flex:1;height:1px;background:var(--border);"></div>
    </div>

    <!-- ── Login Form ── -->
    <form id="loginForm" asp-controller="Account" asp-action="Login" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />

        <!-- Model-level validation summary -->
        <div asp-validation-summary="ModelOnly"
             style="border-radius:var(--radius-lg);background:var(--color-error-bg);border:1px solid var(--color-error-border);color:var(--color-error-strong);font-size:0.8rem;padding:10px 14px;margin-bottom:1rem;"></div>

        <!-- Email -->
        @* <div style="margin-bottom:1rem;">
            <label asp-for="Email"
                   style="display:block;font-size:0.82rem;font-weight:var(--weight-bold);color:var(--color-text);margin-bottom:6px;font-family:var(--font-primary);"></label>
            <input asp-for="Email" type="email" id="loginEmail" placeholder="you@example.com"
                   class="form-control ketabi-input" style="height:48px;font-size:0.875rem;" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div> *@

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email Address</label>
            <div style="position: relative;">
                <input asp-for="Email" class="form-control ketabi-input" placeholder="you@example.com" />
                <!-- الـ span هنا هيفضل موجود بس الـ CSS هيخليه خفيف وجميل -->
                <span asp-for="Email" class="text-danger" style="position: absolute; bottom: -22px; left: 0;"></span>
            </div>
        </div>

        <!-- Password -->
        <div style="margin-bottom:0.5rem;">
            <label asp-for="Password"
                   style="display:block;font-size:0.82rem;font-weight:var(--weight-bold);color:var(--color-text);margin-bottom:6px;font-family:var(--font-primary);"></label>
            <div style="position:relative;">
                <input asp-for="Password" type="password" id="loginPasswordInput" placeholder="••••••••"
                       class="form-control ketabi-input" style="height:48px;font-size:0.875rem;padding-right:48px;" />
                <button type="button" id="loginPasswordToggle"
                        onclick="togglePassword('loginPasswordInput', this)"
                        style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--color-text-muted);padding:4px;line-height:1;"
                        aria-label="Toggle password visibility">
                    <i class="bi bi-eye" style="font-size:16px;"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <!-- Forgot password -->
        <div style="text-align:right;margin-bottom:1.25rem;">
            <a asp-controller="Account" asp-action="ForgotPassword"
               style="font-size:0.78rem;font-weight:var(--weight-semibold);color:var(--color-indigo);text-decoration:none;">Forgot password?</a>
        </div>

        <!-- Submit — ketabi-btn-primary provides color, hover & shadow via CSS class -->
        <button type="submit" id="loginSubmitBtn" class="btn ketabi-btn-primary auth-submit-btn">
            Sign In &nbsp;<i class="bi bi-arrow-right"></i>
        </button>
    </form>

    <!-- Demo notice -->
    <div style="margin-top:1.25rem;padding:12px 16px;border-radius:var(--radius-lg);text-align:center;background:var(--color-indigo-surface);border:1px solid var(--color-indigo-border);">
        <p style="font-size:0.72rem;color:var(--color-indigo-4F);line-height:1.5;margin:0;">
            <strong>Demo mode:</strong> Enter any email &amp; password to explore Ketabi. No real data is stored or processed.
        </p>
    </div>

    <!-- Switch to Register -->
    <p style="text-align:center;margin-top:1.25rem;font-size:0.78rem;color:var(--color-text-muted);">
        Don't have an account?
        <a asp-controller="Account" asp-action="Register"
           style="color:var(--color-indigo);font-weight:var(--weight-bold);text-decoration:none;">Sign up free</a>
    </p>

</div>

@* ═══════════════════════════════════════════════════════
   SCRIPTS — pushed before </body> by _AuthLayout
   ═══════════════════════════════════════════════════════ *@
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Toggle password field visibility
        // function togglePassword(inputId, btn) {
        //     const input = document.getElementById(inputId);
        //     const icon  = btn.querySelector('i');
        //     if (input.type === 'password') {
        //         input.type = 'text';
        //         icon.classList.replace('bi-eye', 'bi-eye-slash');
        //     } else {
        //         input.type = 'password';
        //         icon.classList.replace('bi-eye-slash', 'bi-eye');
        //     }
        // }

        // Show spinner on submit (only when form is valid)
        document.getElementById('loginForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('loginSubmitBtn');
            if (btn && this.checkValidity()) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Signing in\u2026';
            }
        });
    </script>
}
