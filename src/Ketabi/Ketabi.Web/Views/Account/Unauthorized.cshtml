@{
    ViewData["Title"] = "Unauthorized";
}

<section class="container py-5" style="min-height: calc(100vh - 190px);">
    <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 220px);">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card rounded-4 shadow-sm border-0">
                <div class="card-body p-5 text-center">
                    <div class="mx-auto mb-4 d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 96px; height: 96px; background: rgba(239, 68, 68, 0.08);">
                        <i class="bi bi-shield-lock fs-1 text-danger"></i>
                    </div>

                    <h1 class="display-6 fw-bold mb-3">Unauthorized Access</h1>
                    <p class="text-muted fs-5 mb-4">You do not have permission to view this page. If you think this is an error, please contact support or sign in with an account that has the required permissions.</p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">Return to Explore</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4">Sign In</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
