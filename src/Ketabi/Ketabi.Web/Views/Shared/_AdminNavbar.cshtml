@using Ketabi.Application.Interfaces
@using System.Security.Claims
@inject IUserService UserService
@{
    var breadcrumbTitle = ViewData["AdminBreadcrumbTitle"]?.ToString() ?? "Dashboard";
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    
    string userName = "Admin User";
    string avatarUrl = "";
    
    if (Guid.TryParse(userIdClaim, out var userId))
    {
        var userSummary = await UserService.GetUserByIdAsync(userId);
        if (userSummary != null)
        {
            userName = string.IsNullOrWhiteSpace(userSummary.FullName) ? userSummary.UserName : userSummary.FullName;
            avatarUrl = userSummary.AvatarUrl;
        }
    }

    var nameParts = userName.Split(new[] { ' ', '.', '@' }, StringSplitOptions.RemoveEmptyEntries);
    var initials = "AU";
    if (nameParts.Length >= 2)
        initials = $"{nameParts[0][0]}{nameParts[1][0]}".ToUpper();
    else if (nameParts.Length == 1 && nameParts[0].Length >= 2)
        initials = nameParts[0].Substring(0, 2).ToUpper();
    else if (nameParts.Length == 1)
        initials = nameParts[0].ToUpper();
}

<header class="admin-navbar">
    <div class="admin-navbar-left">
        <button class="admin-sidebar-toggle" id="adminSidebarToggle">
            <i class="bi bi-list"></i>
        </button>
        <div class="admin-breadcrumbs">
            <span>Admin</span>
            <span class="separator">/</span>
            <span class="current">@breadcrumbTitle</span>
        </div>
    </div>

    <div class="admin-navbar-right">

        <div class="admin-nav-actions">
            <button class="admin-nav-btn">
                <i class="bi bi-bell"></i>
                <span class="badge">4</span>
            </button>
            @if (!string.IsNullOrEmpty(avatarUrl))
            {
                <img src="/uploads/users/@avatarUrl" alt="@userName" class="admin-top-avatar" style="width:36px;height:36px;object-fit:cover;border-radius:50%;cursor:pointer;" title="@userName" />
            }
            else
            {
                <div class="admin-top-avatar" title="@userName">
                    @initials
                </div>
            }
        </div>
    </div>
</header>
