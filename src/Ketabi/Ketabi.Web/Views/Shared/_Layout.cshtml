<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ketabi</title>

    <!-- 1. Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- 2. Ketabi tokens (CSS custom properties) -->
    <link rel="stylesheet" href="~/css/ketabi-tokens.css" />
    
    <!-- 3. Bootstrap overrides using ketabi tokens -->
    <link rel="stylesheet" href="~/css/ketabi-bootstrap-overrides.css" />
    
    <!-- 4. Ketabi component utilities -->
    <link rel="stylesheet" href="~/css/ketabi-components.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ketabi.Web.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body style="background-color: var(--color-bg); font-family: var(--font-primary);">

    @await Html.PartialAsync("_Navbar")

    <main style="padding-top: var(--navbar-height);">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5">
        <div class="container py-4 text-center">
            &copy; 2026 - Ketabi - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
