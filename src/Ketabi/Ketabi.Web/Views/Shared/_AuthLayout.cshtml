<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Ketabi Design System (order matters) -->
    <link rel="stylesheet" href="~/css/ketabi-tokens.css" />
    <link rel="stylesheet" href="~/css/ketabi-bootstrap-overrides.css" />
    <link rel="stylesheet" href="~/css/ketabi-components.css" />

    <!-- Shared Auth Styles -->
    <link rel="stylesheet" href="~/css/auth-shared.css" />

    <!-- Page-scoped styles pushed by the auth view via section Styles -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body style="margin:0; padding:0; font-family: var(--font-primary); background: var(--color-bg);">

    <div class="auth-page-wrapper">
        <partial name="_AuthSidebar" />
        <div class="auth-right-panel">
            @RenderBody()
        </div>
    </div>

    <!-- jQuery must come before validation plugins -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Page-scoped scripts pushed by the auth view via section Scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
