@model Ketabi.Web.ViewModels.Requests.RequestCardViewModel

@{
    var requestCardStylesAdded = Context.Items.ContainsKey("RequestCardStylesAdded");
}

@if (!requestCardStylesAdded)
{
    Context.Items["RequestCardStylesAdded"] = true;
    <style>
        .request-card {
            position: relative;
            border: 1px solid rgba(91, 91, 214, 0.12);
            border-radius: 28px;
            overflow: hidden;
            background: #ffffff;
            box-shadow: 0 24px 60px rgba(34, 44, 90, 0.08);
            transition: transform 0.24s ease, box-shadow 0.24s ease;
            animation: fadeInUp 0.7s ease both;
        }

        .request-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 32px 80px rgba(34, 44, 90, 0.12);
        }

        .request-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(180deg, rgba(91, 91, 214, 0.92), rgba(63, 81, 181, 0.62));
        }

        .request-card > .card-body {
            position: relative;
            padding-left: 1.5rem;
        }

        .request-card-header {
            border-bottom: none;
            background: transparent;
            padding-bottom: 0;
        }

        .request-card-meta {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            color: #6c757d;
            font-size: 0.88rem;
        }

        .request-card-meta i {
            font-size: 1rem;
            color: #5b5bd6;
        }

        .request-type-chip,
        .request-category-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.4rem 0.8rem;
            border-radius: 999px;
            background: rgba(91, 91, 214, 0.08);
            color: #2f327a;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .request-card-header .badge {
            border-radius: 999px;
            padding: 0.55rem 0.85rem;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .status-supported { background: rgba(56, 189, 248, 0.18); color: #0369a1; }
        .status-pending { background: rgba(253, 186, 116, 0.18); color: #7a5800; }
        .status-approved { background: rgba(34, 197, 94, 0.16); color: #166534; }
        .status-rejected { background: rgba(248, 113, 113, 0.18); color: #9b1c1c; }
        .status-cancelled { background: rgba(107, 114, 128, 0.16); color: #374151; }

        .request-card-body {
            padding-top: 1rem;
        }

        .request-card__book {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 1rem;
            align-items: flex-start;
            margin-bottom: 1.15rem;
        }

        .request-card__book img {
            min-width: 72px;
            width: 72px;
            height: 96px;
            border-radius: 16px;
            object-fit: cover;
            box-shadow: 0 20px 50px rgba(91, 91, 214, 0.08);
        }

        .request-card__title {
            margin-bottom: 0.55rem;
            font-size: 1rem;
            line-height: 1.3;
        }

        .request-card__title a {
            color: #101828;
            text-decoration: none;
        }

        .request-card__title a:hover {
            color: #4f46e5;
            text-decoration: underline;
        }

        .request-card__section {
            border-top: 1px solid rgba(91, 91, 214, 0.08);
            padding-top: 1rem;
            margin-top: 0.5rem;
        }

        .request-card__section small {
            display: block;
            margin-bottom: 0.5rem;
        }

        .request-card__note {
            background: rgba(91, 91, 214, 0.05);
            padding: 0.9rem 1rem;
            border-radius: 18px;
            margin-bottom: 1rem;
        }

        .request-card-footer {
            display: grid;
            gap: 0.75rem;
        }

        .request-card-footer .btn {
            min-height: 42px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .request-card__offered-trigger {
            display: block;
            width: 100%;
            margin: 0;
            padding: 0.85rem 1rem;
            border: 1px solid rgba(91, 91, 214, 0.12);
            border-radius: 16px;
            background: rgba(91, 91, 214, 0.04);
            text-align: left;
            color: inherit;
            cursor: pointer;
            transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
        }

        .request-card__offered-trigger:hover,
        .request-card__offered-trigger:focus-visible {
            background: rgba(91, 91, 214, 0.08);
            border-color: rgba(91, 91, 214, 0.25);
            transform: translateY(-1px);
            outline: none;
        }

        /* Lighter backdrop only for offered-book modals */
        body:has(.offered-book-modal.show) .modal-backdrop {
            --bs-backdrop-opacity: 0.12;
            background-color: rgba(91, 91, 214, 0.08) !important;
        }

        body:has(.offered-book-modal.show) .modal-backdrop.show {
            opacity: 0.12 !important;
            z-index: 1040 !important;
        }

        .offered-book-modal.show {
            z-index: 1055 !important;
        }

        .offered-book-modal .modal-content {
            border: none;
            border-radius: 24px;
            overflow: hidden;
            background: #ffffff;
            box-shadow: 0 32px 80px rgba(27, 36, 80, 0.22);
        }

        .offered-book-modal .modal-header {
            background: #ffffff;
            border-bottom: 1px solid rgba(91, 91, 214, 0.12);
        }

        .offered-book-modal .modal-body {
            background: #ffffff;
        }

        .offered-book-modal .modal-footer {
            background: #ffffff;
            border-top: 1px solid rgba(91, 91, 214, 0.1);
            position: relative;
            z-index: 2;
        }

        .offered-book-modal .modal-footer .obm-btn-view {
            position: relative;
            z-index: 2;
            pointer-events: auto;
        }

        .obm-hero {
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
            margin-bottom: 1.25rem;
        }

        .obm-cover {
            width: 96px;
            height: 132px;
            object-fit: cover;
            border-radius: 14px;
            box-shadow: 0 12px 32px rgba(91, 91, 214, 0.18);
            flex-shrink: 0;
        }

        .obm-title {
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 0.25rem;
        }

        .obm-author {
            color: #6c757d;
            margin-bottom: 0.75rem;
        }

        .obm-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .obm-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .obm-badge-exchange { background: rgba(91, 91, 214, 0.12); color: #3730a3; }
        .obm-badge-borrow { background: rgba(34, 197, 94, 0.12); color: #166534; }
        .obm-badge-both { background: rgba(251, 146, 60, 0.12); color: #92400e; }
        .obm-badge-new { background: rgba(34, 197, 94, 0.12); color: #166534; }
        .obm-badge-good { background: rgba(56, 189, 248, 0.14); color: #0369a1; }
        .obm-badge-fair { background: rgba(251, 191, 36, 0.14); color: #78350f; }
        .obm-badge-worn { background: rgba(248, 113, 113, 0.14); color: #9b1c1c; }

        .obm-meta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.85rem;
        }

        .obm-meta-label {
            display: block;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #9ca3af;
        }

        .obm-meta-value {
            font-size: 0.88rem;
            font-weight: 600;
            color: #2d2d4a;
        }

        .obm-btn-view {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.65rem 1.25rem;
            border-radius: 10px;
            background: linear-gradient(135deg, #5b5bd6, #4f46e5);
            color: #fff !important;
            font-weight: 700;
            text-decoration: none;
        }

        .obm-btn-view:hover {
            color: #fff !important;
            background: linear-gradient(135deg, #4f46e5, #4338ca);
        }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

<div class="card request-card h-100">
    <div class="card-header request-card-header px-3 pt-3 pb-2 bg-transparent">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <small class="text-muted d-block mb-1">Requested on</small>
                <span class="fw-semibold">@Model.RequestDate.ToString("MMM dd, yyyy")</span>
            </div>
            <span class="badge @(Model.Status switch
            {
                Ketabi.Core.Domain.Enums.RequestStatus.Pending => "status-pending",
                Ketabi.Core.Domain.Enums.RequestStatus.Approved => "status-approved",
                Ketabi.Core.Domain.Enums.RequestStatus.Rejected => "status-rejected",
                Ketabi.Core.Domain.Enums.RequestStatus.Cancelled => "status-cancelled",
                Ketabi.Core.Domain.Enums.RequestStatus.Completed => "status-supported",
                _ => "status-pending"
            })">
                @Model.Status.ToString()
            </span>
        </div>
    </div>

    <div class="card-body request-card-body px-3 pb-3">
        <div class="request-card__book">
            <img src="@(string.IsNullOrEmpty(Model.BookImageUrl) ? "/images/book-placeholder.png" : Model.BookImageUrl)"
                 alt="@Model.BookTitle" />
            <div>
                <h5 class="request-card__title">
                    <a href="@Url.Action("Details", "Books", new { id = Model.BookId })">@Model.BookTitle</a>
                </h5>
                <p class="mb-2 text-muted">@Model.BookCategory</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="request-type-chip">
                        <i class="bi bi-arrow-left-right"></i>
                        @(Model.IsBorrow ? "Borrow" : "Exchange")
                    </span>
                    @if (Model.IsBorrow && Model.ReturnDate.HasValue)
                    {
                        <span class="request-category-chip">
                            <i class="bi bi-calendar-check"></i>
                            Return by @Model.ReturnDate.Value.ToString("MMM dd")
                        </span>
                    }
                </div>
            </div>
        </div>

        @if (Model.OfferedBook != null)
        {
            var modalId = $"offeredBookModal-{Model.RequestId:N}";
            var ob = Model.OfferedBook;
            var condBadge = ob.Condition switch
            {
                Ketabi.Core.Domain.Enums.ListingCondition.New => "obm-badge-new",
                Ketabi.Core.Domain.Enums.ListingCondition.LikeNew => "obm-badge-new",
                Ketabi.Core.Domain.Enums.ListingCondition.VeryGood => "obm-badge-good",
                Ketabi.Core.Domain.Enums.ListingCondition.Good => "obm-badge-good",
                Ketabi.Core.Domain.Enums.ListingCondition.Fair => "obm-badge-fair",
                Ketabi.Core.Domain.Enums.ListingCondition.Poor => "obm-badge-worn",
                _ => "obm-badge-good"
            };
            var modeBadge = ob.SharingMode switch
            {
                Ketabi.Core.Domain.Enums.SharingMode.Exchange => "obm-badge-exchange",
                Ketabi.Core.Domain.Enums.SharingMode.Borrow => "obm-badge-borrow",
                Ketabi.Core.Domain.Enums.SharingMode.Both => "obm-badge-both",
                _ => "obm-badge-exchange"
            };
            var modeIcon = ob.SharingMode switch
            {
                Ketabi.Core.Domain.Enums.SharingMode.Borrow => "bi-book",
                _ => "bi-arrow-left-right"
            };

            <div class="request-card__section">
                <small class="text-muted d-block mb-2">Offering in exchange</small>
                <button type="button"
                        class="request-card__offered-trigger"
                        data-bs-toggle="modal"
                        data-bs-target="#@modalId"
                        aria-label="View details of @ob.Title">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@(string.IsNullOrEmpty(ob.ImageUrl) ? "/images/book-placeholder.png" : ob.ImageUrl)"
                             alt="@ob.Title"
                             class="rounded"
                             style="width: 44px; height: 58px; object-fit: cover;" />
                        <div class="flex-grow-1 min-width-0">
                            <div class="fw-semibold text-truncate">@ob.Title</div>
                            <div class="text-muted small text-truncate">@ob.Author</div>
                        </div>
                        <i class="bi bi-box-arrow-up-right text-primary"></i>
                    </div>
                </button>
            </div>

            <div class="modal fade offered-book-modal"
                 id="@modalId"
                 tabindex="-1"
                 aria-labelledby="@(modalId)-label"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="@(modalId)-label">
                                <i class="bi bi-book-half me-1"></i> Offered Book
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="obm-hero">
                                <img src="@(string.IsNullOrEmpty(ob.ImageUrl) ? "/images/book-placeholder.png" : ob.ImageUrl)"
                                     alt="@ob.Title"
                                     class="obm-cover" />
                                <div class="flex-grow-1 min-width-0">
                                    <h5 class="obm-title">@ob.Title</h5>
                                    <p class="obm-author mb-0">@ob.Author</p>
                                    <div class="obm-badges mt-2">
                                        <span class="obm-badge @modeBadge">
                                            <i class="bi @modeIcon"></i> @ob.SharingModeLabel
                                        </span>
                                        <span class="obm-badge @condBadge">@ob.ConditionLabel</span>
                                    </div>
                                </div>
                            </div>
                            <div class="obm-meta-grid">
                                @if (!string.IsNullOrEmpty(ob.Category))
                                {
                                    <div>
                                        <span class="obm-meta-label">Category</span>
                                        <span class="obm-meta-value d-block">@ob.Category</span>
                                    </div>
                                }
                                <div>
                                    <span class="obm-meta-label">Availability</span>
                                    <span class="obm-meta-value d-block">
                                        @(ob.IsAvailable ? "Available" : "Unavailable")
                                    </span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(ob.OwnerName))
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <span class="obm-meta-label">Book owner</span>
                                    <div class="obm-meta-value">@ob.OwnerName</div>
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                            <a href="@Url.Action("Details", "Books", new { id = ob.BookId })"
                               class="obm-btn-view"
                               aria-label="View full details for @ob.Title">
                                <i class="bi bi-box-arrow-up-right"></i> View Full Page
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="request-card__section">
            <div class="d-flex align-items-center gap-2 mb-2">
                <img src="@(string.IsNullOrEmpty(Model.CanAcceptOrReject ? Model.Requester.AvatarUrl : Model.Owner.AvatarUrl) ? "/images/avatar-placeholder.png" : (Model.CanAcceptOrReject ? Model.Requester.AvatarUrl : Model.Owner.AvatarUrl))"
                     alt="@(Model.CanAcceptOrReject ? Model.Requester.FullName : Model.Owner.FullName)"
                     class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" />
                <div>
                    <div class="fw-semibold">@(Model.CanAcceptOrReject ? Model.Requester.FullName : Model.Owner.FullName)</div>
                    <div class="text-muted small">@(Model.CanAcceptOrReject ? Model.Requester.UserName : Model.Owner.UserName)</div>
                </div>
            </div>
            <div class="request-card-meta">
                <span><i class="bi bi-person"></i>@(Model.CanAcceptOrReject ? "Requester" : "Owner")</span>
                <span><i class="bi bi-book-half"></i>@(Model.IsBorrow ? "Borrow request" : "Exchange request")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div class="request-card__note">
                <small class="text-muted">Note</small>
                <div>@Model.Note</div>
            </div>
        }

        <div class="request-card-footer">
            @if (Model.CanAcceptOrReject)
            {
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary btn-sm" onclick="updateRequestStatus('@Model.RequestId', 'Approved')">
                        <i class="bi bi-check-circle me-1"></i>Accept Request
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="updateRequestStatus('@Model.RequestId', 'Rejected')">
                        <i class="bi bi-x-circle me-1"></i>Reject Request
                    </button>
                </div>
            }
            else if (Model.CanWithdraw)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm w-100" onclick="cancelRequest('@Model.RequestId')">
                    <i class="bi bi-x me-1"></i>Cancel Request
                </button>
            }
            else if (Model.Status == Ketabi.Core.Domain.Enums.RequestStatus.Approved)
            {
                <button type="button" class="btn btn-primary btn-sm w-100" onclick="completeRequest('@Model.RequestId')">
                    <i class="bi bi-check2-all me-1"></i>Mark as Completed
                </button>
            }
        </div>
    </div>
</div>

@{
    var offeredBookModalPortalAdded = Context.Items.ContainsKey("OfferedBookModalPortalAdded");
}
@if (!offeredBookModalPortalAdded)
{
    Context.Items["OfferedBookModalPortalAdded"] = true;
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.offered-book-modal').forEach(function (modal) {
                if (modal.closest('.request-card')) {
                    document.body.appendChild(modal);
                }
            });
        });
    </script>
}

<script>
    function updateRequestStatus(requestId, status) {
        const note = status === 'Rejected' ? prompt('Optional note for rejection:') : '';

        fetch('@Url.Action("UpdateStatus", "Requests")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({
                requestId: requestId,
                status: status,
                note: note || ''
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while updating the request.');
        });
    }

    function cancelRequest(requestId) {
        if (!confirm('Are you sure you want to cancel this request?')) return;

        fetch('@Url.Action("CancelRequest", "Requests")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({
                requestId: requestId
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while cancelling the request.');
        });
    }

    function completeRequest(requestId) {
        if (!confirm('Are you sure you want to mark this request as completed?')) return;

        fetch('@Url.Action("CompleteRequest", "Requests")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({
                requestId: requestId
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while completing the request.');
        });
    }
</script>