@model Ketabi.Web.ViewModels.Requests.RequestCardViewModel

@{
    var requestCardStylesAdded = Context.Items.ContainsKey("RequestCardStylesAdded");
    var party = Model.Counterparty;
    var partyRole = Model.CounterpartyRoleLabel;
    var partyHasAvatar = !string.IsNullOrEmpty(party.AvatarUrl);
}

@if (!requestCardStylesAdded)
{
    Context.Items["RequestCardStylesAdded"] = true;
    <style>
        .request-card {
            --rc-radius: 24px;
            --rc-pad-x: 1.25rem;
            --rc-pad-y: 1.15rem;
            --rc-gap: 1rem;
            --rc-indigo: var(--color-indigo, #5b5bd6);
            --rc-indigo-soft: rgba(91, 91, 214, 0.08);
            --rc-border: rgba(91, 91, 214, 0.12);
            position: relative;
            display: flex;
            flex-direction: column;
            height: 100%;
            border: 1px solid var(--rc-border);
            border-radius: var(--rc-radius);
            overflow: hidden;
            background: var(--color-surface, #fff);
            box-shadow: 0 16px 48px rgba(27, 36, 80, 0.06);
            transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            animation: rc-fade-in 0.55s ease both;
        }

        .request-card:hover {
            transform: translateY(-3px);
            border-color: rgba(91, 91, 214, 0.22);
            box-shadow: 0 24px 56px rgba(91, 91, 214, 0.12);
        }

        .request-card::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: linear-gradient(180deg, var(--rc-indigo), #4f46e5 55%, rgba(79, 70, 229, 0.35));
            border-radius: var(--rc-radius) 0 0 var(--rc-radius);
            z-index: 1;
        }

        .request-card::after {
            content: "";
            position: absolute;
            top: -40px;
            right: -40px;
            width: 120px;
            height: 120px;
            background: radial-gradient(circle, rgba(91, 91, 214, 0.07), transparent 68%);
            pointer-events: none;
        }

        .request-card__header {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.75rem;
            padding: var(--rc-pad-y) var(--rc-pad-x) 0.85rem calc(var(--rc-pad-x) + 4px);
            background: linear-gradient(135deg, rgba(91, 91, 214, 0.06), rgba(255, 255, 255, 0));
            border-bottom: 1px solid rgba(91, 91, 214, 0.08);
        }

        .request-card__eyebrow {
            display: block;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-text-muted, #6b7080);
            margin-bottom: 0.2rem;
        }

        .request-card__date {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--color-text, #0c0c14);
            line-height: 1.2;
        }

        .request-card__status {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.45rem 0.85rem;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .request-card__status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            opacity: 0.85;
        }

        .status-pending  { background: rgba(253, 186, 116, 0.2);  color: #7a5800; }
        .status-approved { background: rgba(34, 197, 94, 0.18);   color: #166534; }
        .status-rejected { background: rgba(248, 113, 113, 0.18); color: #9b1c1c; }
        .status-cancelled{ background: rgba(107, 114, 128, 0.14); color: #374151; }
        .status-supported{ background: rgba(56, 189, 248, 0.18);  color: #0369a1; }

        .request-card__body {
            position: relative;
            z-index: 2;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: var(--rc-gap);
            padding: var(--rc-pad-y) var(--rc-pad-x) 0.5rem calc(var(--rc-pad-x) + 4px);
        }

        .request-card__section-label {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin: 0 0 0.65rem;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: var(--color-text-muted, #6b7080);
        }

        .request-card__section-label i {
            font-size: 0.85rem;
            color: var(--rc-indigo);
        }

        .request-card__book {
            display: grid;
            grid-template-columns: 76px 1fr;
            gap: 1rem;
            align-items: start;
            padding: 0.85rem;
            border-radius: 16px;
            background: var(--rc-indigo-soft);
            border: 1px solid rgba(91, 91, 214, 0.1);
        }

        .request-card__cover {
            width: 76px;
            height: 104px;
            border-radius: 12px;
            object-fit: cover;
            box-shadow: 0 10px 28px rgba(91, 91, 214, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.8);
        }

        .request-card__book-meta {
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .request-card__title {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.35;
        }

        .request-card__title a {
            color: var(--color-text, #0c0c14);
            text-decoration: none;
            transition: color 0.15s ease;
        }

        .request-card__title a:hover {
            color: var(--rc-indigo);
        }

        .request-card__category {
            margin: 0;
            font-size: 0.84rem;
            color: var(--color-text-muted, #6b7080);
        }

        .request-card__chips {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
            margin-top: 0.15rem;
        }

        .request-card__chip {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.32rem 0.7rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.75);
            border: 1px solid rgba(91, 91, 214, 0.12);
            color: #2f327a;
        }

        .request-card__chip i {
            font-size: 0.8rem;
            color: var(--rc-indigo);
        }

        .request-card__divider {
            height: 1px;
            margin: 0;
            border: none;
            background: linear-gradient(90deg, transparent, rgba(91, 91, 214, 0.14), transparent);
        }

        .request-card__offered-trigger {
            display: block;
            width: 100%;
            margin: 0;
            padding: 0.75rem 0.85rem;
            border: 1px dashed rgba(91, 91, 214, 0.28);
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(91, 91, 214, 0.04), rgba(255, 255, 255, 0.9));
            text-align: left;
            color: inherit;
            cursor: pointer;
            transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

        .request-card__offered-trigger:hover,
        .request-card__offered-trigger:focus-visible {
            background: rgba(91, 91, 214, 0.08);
            border-color: rgba(91, 91, 214, 0.4);
            border-style: solid;
            box-shadow: 0 6px 18px rgba(91, 91, 214, 0.1);
            transform: translateY(-1px);
            outline: none;
        }

        .request-card__offered-inner {
            display: grid;
            grid-template-columns: 48px 1fr auto;
            gap: 0.75rem;
            align-items: center;
        }

        .request-card__offered-cover {
            width: 48px;
            height: 64px;
            border-radius: 8px;
            object-fit: cover;
            box-shadow: 0 4px 12px rgba(91, 91, 214, 0.12);
        }

        .request-card__offered-text {
            min-width: 0;
        }

        .request-card__offered-title {
            margin: 0;
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--color-text, #0c0c14);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .request-card__offered-author {
            margin: 0.15rem 0 0;
            font-size: 0.78rem;
            color: var(--color-text-muted, #6b7080);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .request-card__offered-action {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: rgba(91, 91, 214, 0.1);
            color: var(--rc-indigo);
            font-size: 0.9rem;
        }

        .request-card__party {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            padding: 0.75rem 0.85rem;
            border-radius: 14px;
            background: rgba(248, 249, 255, 0.9);
            border: 1px solid rgba(91, 91, 214, 0.08);
        }

        .request-card__party-row {
            display: grid;
            grid-template-columns: 44px 1fr;
            gap: 0.85rem;
            align-items: center;
        }

        .request-card__avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
            background: linear-gradient(135deg, var(--rc-indigo), #4f46e5);
            color: #fff;
            font-size: 0.8rem;
            font-weight: 700;
            border: 2px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 4px 12px rgba(91, 91, 214, 0.2);
        }

        .request-card__avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .request-card__party-info {
            min-width: 0;
        }

        .request-card__party-name {
            margin: 0;
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--color-text, #0c0c14);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .request-card__party-handle {
            margin: 0.1rem 0 0.5rem;
            font-size: 0.78rem;
            color: var(--color-text-muted, #6b7080);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .request-card__party-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .request-card__party-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.74rem;
            font-weight: 600;
            color: var(--color-text-muted, #6b7080);
        }

        .request-card__party-tag i {
            color: var(--rc-indigo);
            font-size: 0.82rem;
        }

        .request-card__note {
            padding: 0.85rem 1rem;
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(91, 91, 214, 0.06), rgba(91, 91, 214, 0.02));
            border-left: 3px solid var(--rc-indigo);
            border-top: 1px solid rgba(91, 91, 214, 0.08);
            border-right: 1px solid rgba(91, 91, 214, 0.08);
            border-bottom: 1px solid rgba(91, 91, 214, 0.08);
        }

        .request-card__note-text {
            margin: 0.35rem 0 0;
            font-size: 0.88rem;
            line-height: 1.5;
            color: #2d2d4a;
            word-break: break-word;
        }

        .request-card__footer {
            position: relative;
            z-index: 2;
            padding: 0.85rem var(--rc-pad-x) var(--rc-pad-y) calc(var(--rc-pad-x) + 4px);
            border-top: 1px solid rgba(91, 91, 214, 0.1);
            background: rgba(248, 249, 255, 0.5);
        }

        .request-card__footer .btn {
            min-height: 42px;
            font-size: 0.88rem;
            font-weight: 600;
            border-radius: 12px;
        }

        .request-card__footer .btn-primary {
            box-shadow: 0 8px 20px rgba(91, 91, 214, 0.22);
        }

        /* Offered-book modal */
        body:has(.offered-book-modal.show) .modal-backdrop {
            --bs-backdrop-opacity: 0.12;
            background-color: rgba(91, 91, 214, 0.08) !important;
        }

        body:has(.offered-book-modal.show) .modal-backdrop.show {
            opacity: 0.12 !important;
            z-index: 1040 !important;
        }

        .offered-book-modal.show { z-index: 1055 !important; }

        .offered-book-modal .modal-content {
            border: none;
            border-radius: 24px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 32px 80px rgba(27, 36, 80, 0.22);
        }

        .offered-book-modal .modal-header,
        .offered-book-modal .modal-body,
        .offered-book-modal .modal-footer {
            background: #fff;
        }

        .offered-book-modal .modal-header {
            border-bottom: 1px solid rgba(91, 91, 214, 0.12);
        }

        .offered-book-modal .modal-footer {
            border-top: 1px solid rgba(91, 91, 214, 0.1);
            position: relative;
            z-index: 2;
        }

        .offered-book-modal .modal-footer .obm-btn-view {
            position: relative;
            z-index: 2;
            pointer-events: auto;
        }

        .obm-hero {
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
            margin-bottom: 1.25rem;
        }

        .obm-cover {
            width: 96px;
            height: 132px;
            object-fit: cover;
            border-radius: 14px;
            box-shadow: 0 12px 32px rgba(91, 91, 214, 0.18);
            flex-shrink: 0;
        }

        .obm-title {
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 0.25rem;
        }

        .obm-author { color: #6c757d; margin-bottom: 0.75rem; }

        .obm-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; }

        .obm-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .obm-badge-exchange { background: rgba(91, 91, 214, 0.12); color: #3730a3; }
        .obm-badge-borrow   { background: rgba(34, 197, 94, 0.12);  color: #166534; }
        .obm-badge-both     { background: rgba(251, 146, 60, 0.12); color: #92400e; }
        .obm-badge-new      { background: rgba(34, 197, 94, 0.12);  color: #166534; }
        .obm-badge-good     { background: rgba(56, 189, 248, 0.14); color: #0369a1; }
        .obm-badge-fair     { background: rgba(251, 191, 36, 0.14); color: #78350f; }
        .obm-badge-worn     { background: rgba(248, 113, 113, 0.14); color: #9b1c1c; }

        .obm-meta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.85rem;
        }

        .obm-meta-label {
            display: block;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #9ca3af;
        }

        .obm-meta-value {
            font-size: 0.88rem;
            font-weight: 600;
            color: #2d2d4a;
        }

        .obm-btn-view {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.65rem 1.25rem;
            border-radius: 10px;
            background: linear-gradient(135deg, #5b5bd6, #4f46e5);
            color: #fff !important;
            font-weight: 700;
            text-decoration: none;
        }

        .obm-btn-view:hover {
            color: #fff !important;
            background: linear-gradient(135deg, #4f46e5, #4338ca);
        }

        @@keyframes rc-fade-in {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 400px) {
            .request-card__book {
                grid-template-columns: 64px 1fr;
            }
            .request-card__cover {
                width: 64px;
                height: 88px;
            }
        }
    </style>
}

<article class="card request-card h-100 border-0">
    <header class="request-card__header">
        <div>
            <span class="request-card__eyebrow">
                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>Requested
            </span>
            <time class="request-card__date" datetime="@Model.RequestDate.ToString("yyyy-MM-dd")">
                @Model.RequestDate.ToString("MMM dd, yyyy")
            </time>
        </div>
        <span class="request-card__status @(Model.Status switch
        {
            Ketabi.Core.Domain.Enums.RequestStatus.Pending   => "status-pending",
            Ketabi.Core.Domain.Enums.RequestStatus.Approved  => "status-approved",
            Ketabi.Core.Domain.Enums.RequestStatus.Rejected  => "status-rejected",
            Ketabi.Core.Domain.Enums.RequestStatus.Cancelled   => "status-cancelled",
            Ketabi.Core.Domain.Enums.RequestStatus.Completed => "status-supported",
            _ => "status-pending"
        })">
            @Model.Status.ToString()
        </span>
    </header>

    <div class="request-card__body">
        <section class="request-card__book" aria-label="Requested book">
            <img class="request-card__cover"
                 src="@(string.IsNullOrEmpty(Model.BookImageUrl) ? "/images/book-placeholder.png" : Model.BookImageUrl)"
                 alt="@Model.BookTitle cover" />
            <div class="request-card__book-meta">
                <h3 class="request-card__title">
                    <a href="@Url.Action("Details", "Books", new { id = Model.BookId })">@Model.BookTitle</a>
                </h3>
                <p class="request-card__category">@Model.BookCategory</p>
                <div class="request-card__chips">
                    <span class="request-card__chip">
                        <i class="bi @(Model.IsBorrow ? "bi-book" : "bi-arrow-left-right")" aria-hidden="true"></i>
                        @(Model.IsBorrow ? "Borrow" : "Exchange")
                    </span>
                    @if (Model.IsBorrow && Model.ReturnDate.HasValue)
                    {
                        <span class="request-card__chip">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                            Return @Model.ReturnDate.Value.ToString("MMM dd")
                        </span>
                    }
                </div>
            </div>
        </section>

        @if (Model.OfferedBook != null)
        {
            var modalId = $"offeredBookModal-{Model.RequestId:N}";
            var ob = Model.OfferedBook;
            var condBadge = ob.Condition switch
            {
                Ketabi.Core.Domain.Enums.ListingCondition.New      => "obm-badge-new",
                Ketabi.Core.Domain.Enums.ListingCondition.LikeNew  => "obm-badge-new",
                Ketabi.Core.Domain.Enums.ListingCondition.VeryGood => "obm-badge-good",
                Ketabi.Core.Domain.Enums.ListingCondition.Good     => "obm-badge-good",
                Ketabi.Core.Domain.Enums.ListingCondition.Fair     => "obm-badge-fair",
                Ketabi.Core.Domain.Enums.ListingCondition.Poor     => "obm-badge-worn",
                _ => "obm-badge-good"
            };
            var modeBadge = ob.SharingMode switch
            {
                Ketabi.Core.Domain.Enums.SharingMode.Exchange => "obm-badge-exchange",
                Ketabi.Core.Domain.Enums.SharingMode.Borrow   => "obm-badge-borrow",
                Ketabi.Core.Domain.Enums.SharingMode.Both     => "obm-badge-both",
                _ => "obm-badge-exchange"
            };
            var modeIcon = ob.SharingMode switch
            {
                Ketabi.Core.Domain.Enums.SharingMode.Borrow => "bi-book",
                _ => "bi-arrow-left-right"
            };

            <hr class="request-card__divider" />

            <section aria-label="Book offered in exchange">
                <p class="request-card__section-label">
                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                    Offered in exchange
                </p>
                <button type="button"
                        class="request-card__offered-trigger"
                        data-bs-toggle="modal"
                        data-bs-target="#@modalId"
                        aria-label="View details of @ob.Title">
                    <div class="request-card__offered-inner">
                        <img class="request-card__offered-cover"
                             src="@(string.IsNullOrEmpty(ob.ImageUrl) ? "/images/book-placeholder.png" : ob.ImageUrl)"
                             alt="" />
                        <div class="request-card__offered-text">
                            <p class="request-card__offered-title">@ob.Title</p>
                            <p class="request-card__offered-author">@ob.Author</p>
                        </div>
                        <span class="request-card__offered-action" aria-hidden="true">
                            <i class="bi bi-chevron-right"></i>
                        </span>
                    </div>
                </button>
            </section>

            <div class="modal fade offered-book-modal"
                 id="@modalId"
                 tabindex="-1"
                 aria-labelledby="@(modalId)-label"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="@(modalId)-label">
                                <i class="bi bi-book-half me-1"></i> Offered Book
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="obm-hero">
                                <img src="@(string.IsNullOrEmpty(ob.ImageUrl) ? "/images/book-placeholder.png" : ob.ImageUrl)"
                                     alt="@ob.Title"
                                     class="obm-cover" />
                                <div class="flex-grow-1 min-width-0">
                                    <h5 class="obm-title">@ob.Title</h5>
                                    <p class="obm-author mb-0">@ob.Author</p>
                                    <div class="obm-badges mt-2">
                                        <span class="obm-badge @modeBadge">
                                            <i class="bi @modeIcon"></i> @ob.SharingModeLabel
                                        </span>
                                        <span class="obm-badge @condBadge">@ob.ConditionLabel</span>
                                    </div>
                                </div>
                            </div>
                            <div class="obm-meta-grid">
                                @if (!string.IsNullOrEmpty(ob.Category))
                                {
                                    <div>
                                        <span class="obm-meta-label">Category</span>
                                        <span class="obm-meta-value d-block">@ob.Category</span>
                                    </div>
                                }
                                <div>
                                    <span class="obm-meta-label">Availability</span>
                                    <span class="obm-meta-value d-block">
                                        @(ob.IsAvailable ? "Available" : "Unavailable")
                                    </span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(ob.OwnerName))
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <span class="obm-meta-label">Book owner</span>
                                    <div class="obm-meta-value">@ob.OwnerName</div>
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                            <a href="@Url.Action("Details", "Books", new { id = ob.BookId })"
                               class="obm-btn-view"
                               aria-label="View full details for @ob.Title">
                                <i class="bi bi-box-arrow-up-right"></i> View Full Page
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <hr class="request-card__divider" />

        <section class="request-card__party" aria-label="@Model.CounterpartySectionLabel — @partyRole">
            <p class="request-card__section-label">
                <i class="bi bi-person" aria-hidden="true"></i>
                @Model.CounterpartySectionLabel
            </p>
            <div class="request-card__party-row">
            <div class="request-card__avatar" title="@party.FullName">
                @if (partyHasAvatar)
                {
                    <img src="@party.AvatarUrl" alt="@party.FullName" />
                }
                else
                {
                    <span>@party.Initials</span>
                }
            </div>
            <div class="request-card__party-info">
                <p class="request-card__party-name">@party.FullName</p>
                <p class="request-card__party-handle">@($"@{party.UserName}")</p>
                <div class="request-card__party-tags">
                    <span class="request-card__party-tag">
                        <i class="bi bi-person-badge" aria-hidden="true"></i>@partyRole
                    </span>
                    <span class="request-card__party-tag">
                        <i class="bi @(Model.IsBorrow ? "bi-book" : "bi-arrow-left-right")" aria-hidden="true"></i>
                        @(Model.IsBorrow ? "Borrow" : "Exchange") request
                    </span>
                </div>
            </div>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <blockquote class="request-card__note">
                <p class="request-card__section-label mb-0">
                    <i class="bi bi-chat-quote" aria-hidden="true"></i> Note
                </p>
                <p class="request-card__note-text">@Model.Note</p>
            </blockquote>
        }
    </div>

    @if (Model.CanAcceptOrReject || Model.CanWithdraw || Model.Status == Ketabi.Core.Domain.Enums.RequestStatus.Approved)
    {
        <footer class="request-card__footer">
            @if (Model.CanAcceptOrReject)
            {
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary" onclick="updateRequestStatus('@Model.RequestId', 'Approved')">
                        <i class="bi bi-check-circle me-1"></i>Accept
                    </button>
                    <button type="button" class="btn btn-outline-danger" onclick="updateRequestStatus('@Model.RequestId', 'Rejected')">
                        <i class="bi bi-x-circle me-1"></i>Reject
                    </button>
                </div>
            }
            else if (Model.CanWithdraw)
            {
                <button type="button" class="btn btn-outline-secondary w-100" onclick="cancelRequest('@Model.RequestId')">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Cancel request
                </button>
            }
            else if (Model.Status == Ketabi.Core.Domain.Enums.RequestStatus.Approved)
            {
                <button type="button" class="btn btn-primary w-100" onclick="completeRequest('@Model.RequestId')">
                    <i class="bi bi-check2-circle me-1"></i>Mark completed
                </button>
            }
        </footer>
    }
</article>

@{
    var offeredBookModalPortalAdded = Context.Items.ContainsKey("OfferedBookModalPortalAdded");
    var requestCardScriptsAdded = Context.Items.ContainsKey("RequestCardScriptsAdded");
}
@if (!offeredBookModalPortalAdded)
{
    Context.Items["OfferedBookModalPortalAdded"] = true;
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.offered-book-modal').forEach(function (modal) {
                if (modal.closest('.request-card')) {
                    document.body.appendChild(modal);
                }
            });
        });
    </script>
}
@if (!requestCardScriptsAdded)
{
    Context.Items["RequestCardScriptsAdded"] = true;
    <script>
        function updateRequestStatus(requestId, status) {
            const note = status === 'Rejected' ? prompt('Optional note for rejection:') : '';

            fetch('@Url.Action("UpdateStatus", "Requests")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: new URLSearchParams({
                    requestId: requestId,
                    status: status,
                    note: note || ''
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while updating the request.');
            });
        }

        function cancelRequest(requestId) {
            if (!confirm('Are you sure you want to cancel this request?')) return;

            fetch('@Url.Action("CancelRequest", "Requests")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: new URLSearchParams({ requestId: requestId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) location.reload();
                else alert('Error: ' + data.message);
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while cancelling the request.');
            });
        }

        function completeRequest(requestId) {
            if (!confirm('Are you sure you want to mark this request as completed?')) return;

            fetch('@Url.Action("CompleteRequest", "Requests")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: new URLSearchParams({ requestId: requestId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) location.reload();
                else alert('Error: ' + data.message);
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while completing the request.');
            });
        }
    </script>
}
