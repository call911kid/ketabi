@* Views/Shared/_Navbar.cshtml (Placeholder for now) *@
<header>
    <nav class="navbar navbar-expand-md fixed-top ketabi-glass border-bottom mb-3" style="box-shadow: var(--shadow-navbar); backdrop-filter: var(--blur-lg); -webkit-backdrop-filter: var(--blur-lg);">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-area="" asp-controller="Home" asp-action="Index" style="background: linear-gradient(135deg, var(--color-indigo), var(--color-indigo-dark)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Ketabi
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1 mx-md-4 gap-2">
                    <li class="nav-item">
                        <a class="nav-link fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Explorer</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium" href="#">Requests</a>
                    </li>
                }
            </ul>
        </div>

        <!-- Right actions -->
        <div class="d-flex align-items-center gap-2 gap-sm-3 ms-auto">
            @if (Model?.IsAuthenticated == true)
            {
                <a asp-controller="Books" asp-action="Create" class="navbar-btn-primary d-none d-sm-inline-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                    <span>Add Book</span>
                </a>

                <!-- Message / Chat Icon -->
                <a asp-controller="Chat" asp-action="Index" class="text-decoration-none d-none d-sm-flex align-items-center justify-content-center nav-icon-btn" title="Messages">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </a>

                <!-- Notification Bell -->
                <button class="btn position-relative d-none d-sm-flex align-items-center justify-content-center p-0 border-0 nav-icon-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                    @if (Model.UnreadNotifications > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle p-1 rounded-circle navbar-notification-dot">
                            <span class="visually-hidden">New alerts</span>
                        </span>
                    </button>

                    <div class="dropdown">
                        <a href="#" class="d-block link-dark text-decoration-none dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://github.com/mdo.png" alt="mdo" width="32" height="32" class="rounded-circle" style="box-shadow: var(--shadow-avatar-focus); border: 2px solid white;">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end text-small shadow" aria-labelledby="dropdownUser">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#">Sign out</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>
